# CommunityPass configuration — placeholders only. Copy to .env and fill in.
# NEVER commit real secrets. Secrets live only in this file / your server's environment.

# ── Mode ────────────────────────────────────────────────────────────────
# demo: deterministic mock providers (no real payments, no real messages) + demo seed allowed
# live: real Paystack / WhatsApp Cloud API / Resend (requires the keys below)
APP_MODE=demo
NODE_ENV=production
LOG_LEVEL=info

# Public URL of the web app (used for links in emails and the Paystack callback_url)
WEB_BASE_URL=http://localhost:3000
# Production only: your domain for Caddy (automatic HTTPS)
DOMAIN=communitypass.example.com
# Set true behind HTTPS (docker-compose.prod.yml sets these for you)
COOKIE_SECURE=false
TRUST_PROXY=false
PLATFORM_SUPPORT_EMAIL=support@example.com

# ── Database / Redis (docker compose builds DATABASE_URL from these) ─────
POSTGRES_USER=communitypass
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=communitypass
# For running outside docker compose:
# DATABASE_URL=postgresql://communitypass:change-me@localhost:5432/communitypass
# REDIS_URL=redis://localhost:6379

# ── Paystack (platform account; server-side only) ───────────────────────
# sk_test_... for test mode, sk_live_... for live. Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co

# ── WhatsApp Cloud API (official Meta API; one platform-owned sender) ────
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret — verifies X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=
# Any random string; must match the "Verify token" you enter in the Meta app dashboard
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SENDS_PER_SECOND=10

# ── Email (Resend) ──────────────────────────────────────────────────────
EMAIL_ENABLED=false
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM=CommunityPass <no-reply@mail.example.com>
